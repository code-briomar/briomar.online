---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog • ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.blog-container {
				width: 100%;
				max-width: 760px;
				margin: 0 auto;
				padding: 2rem 1.25rem 4rem;
			}

			.page-header {
				margin-bottom: 2rem;
			}

			.page-title {
				font-size: clamp(2rem, 5vw, 2.5rem);
				font-weight: 800;
				letter-spacing: -0.025em;
				margin-bottom: 0.3em;
				color: rgb(var(--black));
			}

			.page-subtitle {
				font-size: 1.05rem;
				color: rgb(var(--gray));
				margin: 0;
			}

			.posts-grid {
				display: flex;
				flex-direction: column;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}

			.post-item {
				width: 100%;
			}

			.post-card-link {
				display: block;
				text-decoration: none;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid var(--border-light);
				background: var(--bg-surface);
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}

			.post-card-link:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.4);
				border-color: rgba(255, 255, 255, 0.2);
				background: var(--bg-card);
			}

			.post-image-wrap {
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: #0f172a;
			}

			.post-image-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
				transition: transform 0.25s ease;
			}

			.post-card-link:hover .post-image-wrap img {
				transform: scale(1.02);
			}

			.post-details {
				padding: 1.25rem 1.4rem;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.82rem;
				color: rgb(var(--gray));
			}

			.post-badge {
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: var(--accent);
			}

			.post-card-title {
				margin: 0;
				font-size: 1.35rem;
				font-weight: 700;
				line-height: 1.3;
				color: rgb(var(--black));
				transition: color 0.15s ease;
			}

			.post-card-link:hover .post-card-title {
				color: var(--accent);
			}

			.post-card-desc {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.55;
				color: rgb(var(--gray-dark));
			}

			@media (max-width: 640px) {
				.blog-container {
					padding: 1.25rem 1rem 3rem;
				}

				.post-details {
					padding: 1rem;
				}

				.post-card-title {
					font-size: 1.15rem;
				}

				.post-card-desc {
					font-size: 0.9rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="blog-container">
			<header class="page-header">
				<h1 class="page-title">Articles & Teardowns</h1>
				<p class="page-subtitle">Deep investigations into Android internals, mobile architecture, and systems engineering.</p>
			</header>

			<section>
				<ul class="posts-grid">
					{posts.map((post) => (
						<li class="post-item">
							<a href={`/blog/${post.id}/`} class="post-card-link">
								{post.data.heroImage && (
									<div class="post-image-wrap">
										<Image width={760} height={427} src={post.data.heroImage} alt={post.data.title} />
									</div>
								)}
								<div class="post-details">
									<div class="post-meta">
										<span class="post-badge">Engineering</span>
										<span>•</span>
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h2 class="post-card-title">{post.data.title}</h2>
									{post.data.description && (
										<p class="post-card-desc">{post.data.description}</p>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
