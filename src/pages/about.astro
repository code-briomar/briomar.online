---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import threadsData from '../data/threads.json';

const pageTitle = `About & Threads | ${SITE_TITLE}`;
const pageDescription = 'Direct messages and public engineering discussion threads with briomar.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style is:global>
			.about-container {
				max-width: 760px;
				margin: 0 auto;
			}

			.page-intro {
				padding-bottom: 1.5rem;
				margin-bottom: 2rem;
				border-bottom: 1px solid var(--border-subtle);
			}

			.page-title {
				font-size: clamp(2rem, 5vw, 2.5rem);
				letter-spacing: -0.02em;
				margin-bottom: 0;
				color: #ffffff;
			}

			/* Composer Section */
			.composer-card {
				background: #0a0a0a;
				border: 1px solid #222222;
				border-radius: 12px;
				padding: 1.75rem;
				margin-bottom: 3rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
			}

			.card-header {
				margin-bottom: 1.5rem;
			}

			.card-title {
				font-size: 1.35rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 0.35rem;
			}

			.card-desc {
				font-size: 0.95rem;
				color: #a3a3a3;
				line-height: 1.55;
				margin: 0;
			}

			.thread-form {
				display: flex;
				flex-direction: column;
				gap: 1.15rem;
			}

			.form-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.field-group label {
				font-size: 0.88rem;
				font-weight: 600;
				color: #d4d4d4;
			}

			.field-hint {
				font-size: 0.78rem;
				color: #737373;
			}

			.thread-form input[type="text"],
			.thread-form input[type="email"],
			.thread-form textarea {
				background: #141414;
				border: 1px solid #282828;
				border-radius: 8px;
				padding: 0.7rem 0.9rem;
				color: #ffffff;
				font-size: 0.95rem;
				font-family: inherit;
				outline: none;
				transition: border-color 0.15s ease, background 0.15s ease;
			}

			.thread-form input:focus,
			.thread-form textarea:focus {
				border-color: #555555;
				background: #1a1a1a;
			}

			.thread-form textarea {
				resize: vertical;
				min-height: 110px;
			}

			.consent-group {
				display: flex;
				align-items: flex-start;
				gap: 0.65rem;
				padding: 0.75rem 0.9rem;
				background: #111111;
				border: 1px solid #222222;
				border-radius: 8px;
			}

			.consent-group input[type="checkbox"] {
				margin-top: 0.2rem;
				accent-color: #ffffff;
				cursor: pointer;
			}

			.consent-label {
				font-size: 0.86rem;
				color: #a3a3a3;
				line-height: 1.45;
				cursor: pointer;
			}

			.form-actions {
				display: flex;
				justify-content: flex-end;
				align-items: center;
				margin-top: 0.25rem;
			}

			.btn-send {
				background: #ffffff;
				color: #000000;
				border: none;
				border-radius: 8px;
				padding: 0.65rem 1.4rem;
				font-size: 0.92rem;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.15s ease, transform 0.1s ease;
				display: inline-flex;
				align-items: center;
			}

			.btn-send:hover {
				background: #e5e5e5;
			}

			.btn-send:active {
				transform: scale(0.98);
			}

			.btn-send:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.status-banner {
				border-radius: 8px;
				padding: 0.85rem 1rem;
				font-size: 0.9rem;
				line-height: 1.45;
			}

			.status-banner.success {
				background: #0f2416;
				border: 1px solid #1c522e;
				color: #86efac;
			}

			.status-banner.error {
				background: #2b1212;
				border: 1px solid #571b1b;
				color: #fca5a5;
			}

			/* Threads Section */
			.threads-section {
				margin-top: 2.5rem;
			}

			.threads-heading-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.25rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid #1a1a1a;
			}

			.threads-title {
				font-size: 1.35rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0;
			}

			.threads-count {
				font-size: 0.8rem;
				color: #888888;
				background: #141414;
				border: 1px solid #242424;
				padding: 0.2rem 0.65rem;
				border-radius: 9999px;
				font-weight: 500;
			}

			.threads-list {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			/* Thread Card */
			.thread-card {
				background: #0d0d0d;
				border: 1px solid #222222;
				border-radius: 12px;
				padding: 1.35rem 1.5rem;
				transition: border-color 0.15s ease;
			}

			.thread-card:hover {
				border-color: #333333;
			}

			.thread-card.pending {
				border-color: #262626;
				background: #0a0a0a;
			}

			.thread-top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.75rem;
			}

			.thread-pill-group {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.channel-pill {
				font-size: 0.76rem;
				font-weight: 600;
				color: #a3a3a3;
				background: #171717;
				border: 1px solid #262626;
				padding: 0.15rem 0.55rem;
				border-radius: 4px;
				font-family: monospace;
			}

			.status-pill {
				font-size: 0.72rem;
				font-weight: 600;
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			.status-pill.pending {
				background: rgba(245, 158, 11, 0.12);
				color: #fbbf24;
				border: 1px solid rgba(245, 158, 11, 0.25);
			}

			.status-pill.answered {
				background: rgba(34, 197, 94, 0.12);
				color: #4ade80;
				border: 1px solid rgba(34, 197, 94, 0.25);
			}

			.thread-date {
				font-size: 0.78rem;
				color: #666666;
			}

			.thread-topic-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0 0 1rem 0;
				line-height: 1.4;
			}

			/* Question Block */
			.thread-question-block {
				display: flex;
				align-items: flex-start;
				gap: 0.85rem;
			}

			.user-avatar-circle {
				width: 32px;
				height: 32px;
				min-width: 32px;
				border-radius: 50%;
				background: #1f1f1f;
				border: 1px solid #333333;
				color: #ffffff;
				font-size: 0.78rem;
				font-weight: 700;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.thread-question-body {
				flex: 1;
			}

			.thread-user-info {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				margin-bottom: 0.35rem;
			}

			.user-display-name {
				font-size: 0.9rem;
				font-weight: 600;
				color: #ffffff;
			}

			.thread-message-text {
				font-size: 0.93rem;
				line-height: 1.6;
				color: #cccccc;
				margin: 0;
				white-space: pre-wrap;
				word-break: break-word;
			}

			/* Pending Footer */
			.thread-pending-footer {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-top: 1rem;
				padding-top: 0.85rem;
				border-top: 1px solid #1a1a1a;
				font-size: 0.82rem;
				color: #888888;
			}

			.pending-dot {
				width: 6px;
				height: 6px;
				min-width: 6px;
				border-radius: 50%;
				background: #fbbf24;
			}

			/* Author Reply Box */
			.thread-author-reply {
				margin-top: 1.15rem;
				padding-top: 1rem;
				border-top: 1px solid #222222;
				display: flex;
				align-items: flex-start;
				gap: 0.85rem;
			}

			.author-avatar-badge {
				width: 30px;
				height: 30px;
				min-width: 30px;
				border-radius: 6px;
				background: #ffffff;
				color: #000000;
				font-size: 0.78rem;
				font-weight: 800;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.author-reply-body {
				flex: 1;
			}

			.author-title-line {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.35rem;
			}

			.author-name {
				font-size: 0.88rem;
				font-weight: 700;
				color: #ffffff;
			}

			.author-tag {
				font-size: 0.7rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				background: #222222;
				border: 1px solid #333333;
				color: #e5e5e5;
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
			}

			.reply-date {
				font-size: 0.75rem;
				color: #666666;
				margin-left: auto;
			}

			.author-reply-text {
				font-size: 0.92rem;
				line-height: 1.6;
				color: #d4d4d4;
				margin: 0;
			}

			@media (max-width: 640px) {
				.form-row {
					grid-template-columns: 1fr;
				}

				.composer-card {
					padding: 1.25rem;
				}

				.thread-card {
					padding: 1.15rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about-container">
			<section class="page-intro">
				<h1 class="page-title">briomar.site</h1>
			</section>

			<!-- Message Composer -->
			<section class="composer-card">
				<div class="card-header">
					<h2 class="card-title">Send a Message</h2>
					<p class="card-desc">
						Got a question, feedback, or a teardown suggestion? Send a message below. I receive an email notification directly. Your email is kept private and never shown on this site.
					</p>
				</div>

				<form id="thread-composer" class="thread-form">
					<div class="form-row">
						<div class="field-group">
							<label for="sender-name">Your Name or Handle *</label>
							<input
								type="text"
								id="sender-name"
								placeholder="e.g. Kelvin (@kelvin)"
								required
								maxlength="50"
							/>
						</div>
						<div class="field-group">
							<label for="sender-email">Your Email *</label>
							<input
								type="email"
								id="sender-email"
								placeholder="name@example.com"
								required
							/>
							<span class="field-hint">Used only for direct email replies. Never displayed publicly.</span>
						</div>
					</div>

					<div class="field-group">
						<label for="thread-topic">Topic / Subject *</label>
						<input
							type="text"
							id="thread-topic"
							placeholder="e.g. Question on USSD direct modem vs Accessibility service"
							required
							maxlength="100"
						/>
					</div>

					<div class="field-group">
						<label for="thread-message">Message *</label>
						<textarea
							id="thread-message"
							rows="4"
							placeholder="Share your benchmarks, teardown requests, or technical questions..."
							required
							maxlength="2000"
						></textarea>
					</div>

					<div class="consent-group">
						<input type="checkbox" id="public-consent" checked />
						<label for="public-consent" class="consent-label">
							Allow this message and reply to be published as a public thread
						</label>
					</div>

					<div class="form-actions">
						<button type="submit" id="submit-btn" class="btn-send">
							<span id="btn-text">Send Message</span>
						</button>
					</div>

					<div id="status-banner" class="status-banner" style="display: none;"></div>
				</form>
			</section>

			<!-- Public Threads Feed -->
			<section class="threads-section" id="threads-section" style={threadsData.length === 0 ? "display: none;" : ""}>
				<div class="threads-heading-row">
					<h2 class="threads-title">Discussion Threads</h2>
					<span class="threads-count" id="thread-count-badge">
						{threadsData.length} {threadsData.length === 1 ? 'Thread' : 'Threads'}
					</span>
				</div>

				<div class="threads-list" id="threads-container">
					{threadsData.map((t) => (
						<article class="thread-card" id={t.id}>
							<div class="thread-top-bar">
								<div class="thread-pill-group">
									<span class="channel-pill">#{t.channel}</span>
									<span class="status-pill answered">Answered</span>
								</div>
								<span class="thread-date">{t.date}</span>
							</div>
							<h3 class="thread-topic-title">{t.title}</h3>

							<div class="thread-question-block">
								<div class="user-avatar-circle">
									{t.author.name.slice(0, 2).toUpperCase()}
								</div>
								<div class="thread-question-body">
									<div class="thread-user-info">
										<span class="user-display-name">{t.author.name}</span>
									</div>
									<p class="thread-message-text">{t.question}</p>
								</div>
							</div>

							{t.reply && (
								<div class="thread-author-reply">
									<div class="author-avatar-badge">BR</div>
									<div class="author-reply-body">
										<div class="author-title-line">
											<span class="author-name">briomar</span>
											<span class="author-tag">Author</span>
											<span class="reply-date">{t.reply.date}</span>
										</div>
										<p class="author-reply-text">{t.reply.content}</p>
									</div>
								</div>
							)}
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Client-side thread handler & FormSubmit dispatcher
			function initThreadSystem() {
				const form = document.getElementById('thread-composer') as HTMLFormElement | null;
				const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
				const btnText = document.getElementById('btn-text');
				const statusBanner = document.getElementById('status-banner');
				const threadsContainer = document.getElementById('threads-container');
				const threadsSection = document.getElementById('threads-section');

				if (!form) return;

				const PENDING_STORAGE_KEY = 'briomar_pending_threads';
				let pendingThreads: Array<{
					id: string;
					channel: string;
					title: string;
					name: string;
					question: string;
					date: string;
					isPublic: boolean;
				}> = [];

				try {
					const saved = localStorage.getItem(PENDING_STORAGE_KEY);
					if (saved) pendingThreads = JSON.parse(saved);
				} catch (err) {
					console.error(err);
				}

				function renderPendingThreads() {
					if (!threadsContainer) return;

					document.querySelectorAll('.thread-card.pending').forEach((el) => el.remove());

					if (pendingThreads.length > 0 && threadsSection) {
						threadsSection.style.display = 'block';
					}

					pendingThreads.forEach((pt) => {
						const card = document.createElement('article');
						card.className = 'thread-card pending';
						card.innerHTML = `
							<div class="thread-top-bar">
								<div class="thread-pill-group">
									<span class="channel-pill">#${escapeHTML(pt.channel || 'general')}</span>
									<span class="status-pill pending">Pending Review</span>
								</div>
								<span class="thread-date">${escapeHTML(pt.date)}</span>
							</div>
							<h3 class="thread-topic-title">${escapeHTML(pt.title)}</h3>
							<div class="thread-question-block">
								<div class="user-avatar-circle">
									${escapeHTML(pt.name.slice(0, 2).toUpperCase())}
								</div>
								<div class="thread-question-body">
									<div class="thread-user-info">
										<span class="user-display-name">${escapeHTML(pt.name)}</span>
									</div>
									<p class="thread-message-text">${escapeHTML(pt.question)}</p>
								</div>
							</div>
							<div class="thread-pending-footer">
								<span class="pending-dot"></span>
								<span>Email notification sent to briomar. Awaiting review.</span>
							</div>
						`;
						threadsContainer.prepend(card);
					});
				}

				renderPendingThreads();

				form.addEventListener('submit', async (e) => {
					e.preventDefault();

					const nameInput = document.getElementById('sender-name') as HTMLInputElement;
					const emailInput = document.getElementById('sender-email') as HTMLInputElement;
					const topicInput = document.getElementById('thread-topic') as HTMLInputElement;
					const messageInput = document.getElementById('thread-message') as HTMLTextAreaElement;
					const consentInput = document.getElementById('public-consent') as HTMLInputElement;

					const name = nameInput.value.trim();
					const email = emailInput.value.trim();
					const subject = topicInput.value.trim();
					const message = messageInput.value.trim();
					const isPublic = consentInput.checked;

					if (!name || !email || !message) return;

					if (submitBtn && btnText) {
						submitBtn.disabled = true;
						btnText.textContent = 'Sending...';
					}

					if (statusBanner) {
						statusBanner.style.display = 'none';
					}

					const FORMSUBMIT_TOKEN = 'ef85b9414634ca2372efb1e56fb37906';

					try {
						const response = await fetch(`https://formsubmit.co/ajax/${FORMSUBMIT_TOKEN}`, {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								Accept: 'application/json',
							},
							body: JSON.stringify({
								name: name,
								email: email,
								_replyto: email,
								_subject: `[briomar.site] ${subject || 'New Message'}`,
								topic: subject,
								public_consent: isPublic ? 'Yes' : 'No',
								message: message,
							}),
						});

						const result = await response.json().catch(() => ({ success: false }));

						if (response.ok && (result.success === 'true' || result.success === true)) {
							showStatus(
								'Message sent. An email notification has been dispatched. If selected, your thread will appear below once answered.',
								'success'
							);

							if (isPublic) {
								const newPending = {
									id: `pending-${Date.now()}`,
									channel: 'discussion',
									title: subject || 'General Discussion',
									name: name,
									question: message,
									date: 'Just now',
									isPublic: isPublic,
								};

								pendingThreads.unshift(newPending);
								try {
									localStorage.setItem(PENDING_STORAGE_KEY, JSON.stringify(pendingThreads));
								} catch {}

								renderPendingThreads();
							}

							form.reset();
							consentInput.checked = true;
						} else {
							throw new Error(result.message || 'Failed to dispatch message');
						}
					} catch (err: any) {
						showStatus(
							'Could not send message. Please check your connection and try again.',
							'error'
						);
					} finally {
						if (submitBtn && btnText) {
							submitBtn.disabled = false;
							btnText.textContent = 'Send Message';
						}
					}
				});

				function showStatus(msg: string, type: 'success' | 'error') {
					if (!statusBanner) return;
					statusBanner.textContent = msg;
					statusBanner.className = `status-banner ${type}`;
					statusBanner.style.display = 'block';
					statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}

				function escapeHTML(str: string): string {
					const div = document.createElement('div');
					div.textContent = str;
					return div.innerHTML;
				}
			}

			initThreadSystem();
			document.addEventListener('astro:page-load', initThreadSystem);
		</script>
	</body>
</html>
