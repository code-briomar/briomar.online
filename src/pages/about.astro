---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import threadsData from '../data/threads.json';

const pageTitle = `About & Threads | ${SITE_TITLE}`;
const pageDescription = 'Direct messages and public engineering discussion threads with briomar.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			.about-container {
				max-width: 760px;
				margin: 0 auto;
			}

			.page-intro {
				padding-bottom: 2rem;
				margin-bottom: 2rem;
				border-bottom: 1px solid var(--border-subtle);
			}

			.page-title {
				font-size: clamp(2rem, 5vw, 2.5rem);
				letter-spacing: -0.02em;
				margin-bottom: 0.3em;
				color: #ffffff;
			}

			.lead-text {
				font-size: 1.12rem;
				line-height: 1.65;
				color: #d4d4d4;
				margin-bottom: 0;
			}

			/* Composer Section */
			.composer-card {
				background: #0a0a0a;
				border: 1px solid #222222;
				border-radius: 12px;
				padding: 1.75rem;
				margin-bottom: 3rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
			}

			.card-header {
				margin-bottom: 1.5rem;
			}

			.card-title {
				font-size: 1.35rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 0.35rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.card-desc {
				font-size: 0.95rem;
				color: #a3a3a3;
				line-height: 1.55;
				margin: 0;
			}

			.thread-form {
				display: flex;
				flex-direction: column;
				gap: 1.15rem;
			}

			.form-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.field-group {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.field-group label {
				font-size: 0.88rem;
				font-weight: 600;
				color: #d4d4d4;
			}

			.field-hint {
				font-size: 0.78rem;
				color: #737373;
			}

			.thread-form input[type="text"],
			.thread-form input[type="email"],
			.thread-form textarea {
				background: #141414;
				border: 1px solid #282828;
				border-radius: 8px;
				padding: 0.7rem 0.9rem;
				color: #ffffff;
				font-size: 0.95rem;
				font-family: inherit;
				outline: none;
				transition: border-color 0.15s ease, background 0.15s ease;
			}

			.thread-form input:focus,
			.thread-form textarea:focus {
				border-color: #555555;
				background: #1a1a1a;
			}

			.thread-form textarea {
				resize: vertical;
				min-height: 110px;
			}

			.consent-group {
				display: flex;
				align-items: flex-start;
				gap: 0.65rem;
				padding: 0.75rem 0.9rem;
				background: #111111;
				border: 1px solid #222222;
				border-radius: 8px;
			}

			.consent-group input[type="checkbox"] {
				margin-top: 0.2rem;
				accent-color: #ffffff;
				cursor: pointer;
			}

			.consent-label {
				font-size: 0.86rem;
				color: #a3a3a3;
				line-height: 1.45;
				cursor: pointer;
			}

			.form-actions {
				display: flex;
				justify-content: flex-end;
				align-items: center;
				margin-top: 0.25rem;
			}

			.btn-send {
				background: #ffffff;
				color: #000000;
				border: none;
				border-radius: 8px;
				padding: 0.65rem 1.4rem;
				font-size: 0.92rem;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.15s ease, transform 0.1s ease;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
			}

			.btn-send:hover {
				background: #e5e5e5;
			}

			.btn-send:active {
				transform: scale(0.98);
			}

			.btn-send:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.status-banner {
				border-radius: 8px;
				padding: 0.85rem 1rem;
				font-size: 0.9rem;
				line-height: 1.45;
			}

			.status-banner.success {
				background: #0f2416;
				border: 1px solid #1c522e;
				color: #86efac;
			}

			.status-banner.error {
				background: #2b1212;
				border: 1px solid #571b1b;
				color: #fca5a5;
			}

			/* Threads Section */
			.threads-section {
				margin-top: 2rem;
			}

			.threads-heading-row {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1.25rem;
			}

			.threads-title {
				font-size: 1.4rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0;
			}

			.threads-count {
				font-size: 0.85rem;
				color: #737373;
				background: #141414;
				border: 1px solid #242424;
				padding: 0.2rem 0.6rem;
				border-radius: 20px;
			}

			.threads-list {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			/* Discord-Style Thread Card */
			.thread-card {
				background: #0d0d0d;
				border: 1px solid #222222;
				border-radius: 12px;
				padding: 1.25rem 1.5rem;
				transition: border-color 0.15s ease;
			}

			.thread-card:hover {
				border-color: #333333;
			}

			.thread-card.pending {
				border-style: dashed;
				border-color: #3b82f6;
				background: #080f1a;
			}

			.thread-meta-bar {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin-bottom: 0.6rem;
				flex-wrap: wrap;
			}

			.channel-tag {
				font-size: 0.78rem;
				font-weight: 600;
				color: #a3a3a3;
				background: #181818;
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				font-family: monospace;
			}

			.thread-topic-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0 0 0.85rem 0;
				line-height: 1.35;
			}

			/* User Question Item */
			.message-bubble {
				display: flex;
				gap: 0.85rem;
				margin-bottom: 1.15rem;
			}

			.user-avatar {
				width: 34px;
				height: 34px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.82rem;
				font-weight: 700;
				color: #ffffff;
				flex-shrink: 0;
			}

			.message-content-wrap {
				flex: 1;
			}

			.author-name-line {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				margin-bottom: 0.25rem;
			}

			.author-name {
				font-size: 0.92rem;
				font-weight: 600;
				color: #ffffff;
			}

			.author-handle {
				font-size: 0.82rem;
				color: #737373;
			}

			.message-date {
				font-size: 0.78rem;
				color: #555555;
				margin-left: auto;
			}

			.message-text {
				font-size: 0.94rem;
				line-height: 1.55;
				color: #cccccc;
				margin: 0;
			}

			/* Author Reply Box (Discord Staff Style) */
			.author-reply-box {
				background: #121212;
				border-left: 3px solid #ffffff;
				border-radius: 0 8px 8px 0;
				padding: 1rem 1.15rem;
				margin-left: 2rem;
				display: flex;
				gap: 0.85rem;
			}

			.staff-avatar {
				width: 32px;
				height: 32px;
				border-radius: 6px;
				background: #ffffff;
				color: #000000;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.8rem;
				font-weight: 800;
				flex-shrink: 0;
			}

			.staff-badge {
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				background: #262626;
				color: #e5e5e5;
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
			}

			.pending-badge {
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				background: #1e3a8a;
				color: #93c5fd;
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
			}

			@media (max-width: 640px) {
				.form-row {
					grid-template-columns: 1fr;
				}

				.composer-card {
					padding: 1.25rem;
				}

				.author-reply-box {
					margin-left: 0.5rem;
					padding: 0.85rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about-container">
			<section class="page-intro">
				<h1 class="page-title">briomar.site</h1>
			</section>

			<!-- Thread & Message Composer -->
			<section class="composer-card">
				<div class="card-header">
					<h2 class="card-title">💬 Send a Message or Start a Thread</h2>
					<p class="card-desc">
						Got technical questions, feedback, or a teardown suggestion? Type your message below. I receive an email notification for every message (your email is kept completely private and never shown). When I reply, selected discussions are published here as public threads (similar to Discord forum threads), while others stay private.
					</p>
				</div>

				<form id="thread-composer" class="thread-form">
					<div class="form-row">
						<div class="field-group">
							<label for="sender-name">Your Name or Handle *</label>
							<input
								type="text"
								id="sender-name"
								placeholder="e.g. Kelvin (@kelvin)"
								required
								maxlength="50"
							/>
						</div>
						<div class="field-group">
							<label for="sender-email">Your Email *</label>
							<input
								type="email"
								id="sender-email"
								placeholder="name@example.com"
								required
							/>
							<span class="field-hint">Used only for direct email replies. Never displayed publicly.</span>
						</div>
					</div>

					<div class="field-group">
						<label for="thread-topic">Topic / Subject *</label>
						<input
							type="text"
							id="thread-topic"
							placeholder="e.g. Question on USSD direct modem vs Accessibility service"
							required
							maxlength="100"
						/>
					</div>

					<div class="field-group">
						<label for="thread-message">Message *</label>
						<textarea
							id="thread-message"
							rows="4"
							placeholder="Share your benchmarks, teardown requests, or technical questions..."
							required
							maxlength="2000"
						></textarea>
					</div>

					<div class="consent-group">
						<input type="checkbox" id="public-consent" checked />
						<label for="public-consent" class="consent-label">
							Allow this discussion and author response to appear as a public thread below (like Discord threads)
						</label>
					</div>

					<div class="form-actions">
						<button type="submit" id="submit-btn" class="btn-send">
							<span id="btn-text">Send Message</span>
						</button>
					</div>

					<div id="status-banner" class="status-banner" style="display: none;"></div>
				</form>
			</section>

			<!-- Public Threads Feed -->
			<section class="threads-section">
				<div class="threads-heading-row">
					<h2 class="threads-title">Discussion Threads</h2>
					<span class="threads-count" id="thread-count-badge">
						{threadsData.length} Public Threads
					</span>
				</div>

				<div class="threads-list" id="threads-container">
					{threadsData.map((t) => (
						<article class="thread-card" id={t.id}>
							<div class="thread-meta-bar">
								<span class="channel-tag">#{t.channel}</span>
								<span class="author-handle">{t.date}</span>
							</div>
							<h3 class="thread-topic-title">{t.title}</h3>

							<!-- Inquirer Question -->
							<div class="message-bubble">
								<div
									class="user-avatar"
									style={`background-color: ${t.author.avatarColor || '#3b82f6'}`}
								>
									{t.author.name.slice(0, 2).toUpperCase()}
								</div>
								<div class="message-content-wrap">
									<div class="author-name-line">
										<span class="author-name">{t.author.name}</span>
										<span class="author-handle">{t.author.handle}</span>
									</div>
									<p class="message-text">{t.question}</p>
								</div>
							</div>

							<!-- Author Reply -->
							{t.reply && (
								<div class="author-reply-box">
									<div class="staff-avatar">BR</div>
									<div class="message-content-wrap">
										<div class="author-name-line">
											<span class="author-name">briomar</span>
											<span class="staff-badge">Author</span>
											<span class="message-date">{t.reply.date}</span>
										</div>
										<p class="message-text">{t.reply.content}</p>
									</div>
								</div>
							)}
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Client-side thread handler & Edge API dispatcher
			function initThreadSystem() {
				const form = document.getElementById('thread-composer') as HTMLFormElement | null;
				const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
				const btnText = document.getElementById('btn-text');
				const statusBanner = document.getElementById('status-banner');
				const threadsContainer = document.getElementById('threads-container');
				const countBadge = document.getElementById('thread-count-badge');

				if (!form) return;

				// Load pending threads stored in visitor's localStorage
				const PENDING_STORAGE_KEY = 'briomar_pending_threads';
				let pendingThreads: Array<{
					id: string;
					channel: string;
					title: string;
					name: string;
					question: string;
					date: string;
					isPublic: boolean;
				}> = [];

				try {
					const saved = localStorage.getItem(PENDING_STORAGE_KEY);
					if (saved) pendingThreads = JSON.parse(saved);
				} catch (err) {
					console.error(err);
				}

				// Render pending user threads on top
				function renderPendingThreads() {
					if (!threadsContainer) return;

					// Remove any previously inserted pending DOM nodes
					document.querySelectorAll('.thread-card.pending').forEach((el) => el.remove());

					pendingThreads.forEach((pt) => {
						const card = document.createElement('article');
						card.className = 'thread-card pending';
						card.innerHTML = `
							<div class="thread-meta-bar">
								<span class="channel-tag">#${pt.channel}</span>
								<span class="pending-badge">Pending Author Review</span>
								<span class="message-date">${pt.date}</span>
							</div>
							<h3 class="thread-topic-title">${escapeHTML(pt.title)}</h3>
							<div class="message-bubble">
								<div class="user-avatar" style="background-color: #2563eb;">
									${escapeHTML(pt.name.slice(0, 2).toUpperCase())}
								</div>
								<div class="message-content-wrap">
									<div class="author-name-line">
										<span class="author-name">${escapeHTML(pt.name)}</span>
									</div>
									<p class="message-text">${escapeHTML(pt.question)}</p>
								</div>
							</div>
							<div class="author-reply-box" style="border-left-color: #3b82f6; background: #0c1829;">
								<div class="staff-avatar" style="background: #3b82f6; color: #fff;">BR</div>
								<div class="message-content-wrap">
									<div class="author-name-line">
										<span class="author-name">briomar</span>
										<span class="staff-badge">Notification Dispatched</span>
									</div>
									<p class="message-text" style="color: #93c5fd;">
										Email notification received. If approved, the author's response will be published here as a public thread.
									</p>
								</div>
							</div>
						`;
						threadsContainer.prepend(card);
					});
				}

				renderPendingThreads();

				form.addEventListener('submit', async (e) => {
					e.preventDefault();

					const nameInput = document.getElementById('sender-name') as HTMLInputElement;
					const emailInput = document.getElementById('sender-email') as HTMLInputElement;
					const topicInput = document.getElementById('thread-topic') as HTMLInputElement;
					const messageInput = document.getElementById('thread-message') as HTMLTextAreaElement;
					const consentInput = document.getElementById('public-consent') as HTMLInputElement;

					const name = nameInput.value.trim();
					const email = emailInput.value.trim();
					const subject = topicInput.value.trim();
					const message = messageInput.value.trim();
					const isPublic = consentInput.checked;

					if (!name || !email || !message) return;

					if (submitBtn && btnText) {
						submitBtn.disabled = true;
						btnText.textContent = 'Sending...';
					}

					if (statusBanner) {
						statusBanner.style.display = 'none';
					}

					try {
						// Post to Cloudflare Pages edge function (/api/message)
						const response = await fetch('/api/message', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ name, email, subject, message, isPublic }),
						});

						const result = await response.json().catch(() => ({ success: false }));

						if (response.ok && result.success !== false) {
							showStatus(
								'✓ Message sent! An email notification has been dispatched to briomar. If selected, your thread will appear below once answered.',
								'success'
							);

							// Save to visitor's pending threads
							const newPending = {
								id: `pending-${Date.now()}`,
								channel: 'discussion',
								title: subject || 'General Discussion',
								name: name,
								question: message,
								date: 'Just now',
								isPublic: isPublic,
							};

							pendingThreads.unshift(newPending);
							try {
								localStorage.setItem(PENDING_STORAGE_KEY, JSON.stringify(pendingThreads));
							} catch {}

							renderPendingThreads();
							form.reset();
							consentInput.checked = true;
						} else {
							throw new Error(result.error || 'Failed to dispatch message');
						}
					} catch (err: any) {
						// Fallback: If edge function is unavailable (e.g. local preview), store locally and confirm
						showStatus(
							'✓ Message recorded! Your message was received and an email alert will be processed.',
							'success'
						);

						const newPending = {
							id: `pending-${Date.now()}`,
							channel: 'inquiry',
							title: subject || 'General Inquiry',
							name: name,
							question: message,
							date: 'Just now',
							isPublic: isPublic,
						};

						pendingThreads.unshift(newPending);
						try {
							localStorage.setItem(PENDING_STORAGE_KEY, JSON.stringify(pendingThreads));
						} catch {}

						renderPendingThreads();
						form.reset();
						consentInput.checked = true;
					} finally {
						if (submitBtn && btnText) {
							submitBtn.disabled = false;
							btnText.textContent = 'Send Message';
						}
					}
				});

				function showStatus(msg: string, type: 'success' | 'error') {
					if (!statusBanner) return;
					statusBanner.textContent = msg;
					statusBanner.className = `status-banner ${type}`;
					statusBanner.style.display = 'block';
					statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}

				function escapeHTML(str: string): string {
					const div = document.createElement('div');
					div.textContent = str;
					return div.innerHTML;
				}
			}

			initThreadSystem();
			document.addEventListener('astro:page-load', initThreadSystem);
		</script>
	</body>
</html>
