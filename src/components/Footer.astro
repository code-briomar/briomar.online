---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<p class="copyright">&copy; {today.getFullYear()} briomar.site. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		padding: 3rem 1.25rem 4rem;
		border-top: 1px solid var(--border-subtle);
		background: #000000;
		color: #737373;
		text-align: center;
	}

	.footer-container {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.copyright {
		margin: 0;
		font-size: 0.88rem;
		color: #737373;
	}
</style>
